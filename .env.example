# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram chat id of the seller (gets order notifications). Send /whoami to the bot to find yours.
SELLER_CHAT_ID=
# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook id from the PayPal app's webhook settings (for signature verification)
PAYPAL_WEBHOOK_ID=
CURRENCY=USD
# Otari LLM gateway (https://otari.ai): workspace API key and base URL (note /api/v1, not /v1)
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1
# Model (or Otari routing policy name) the sales agent uses
LLM_MODEL=openai/gpt-oss-120b
# App-side fallback chain if the policy/model fails
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,deepseek/deepseek-v4-flash,meta/llama-3.3-70b-instruct
# Other roles (all open-weight, all through Otari)
GUARD_MODEL=meta/llama-guard-4-12b
SCOUT_MODEL=deepseek/deepseek-v4-flash
QUOTE_MODEL=deepseek/deepseek-v4-flash
GUARD_ENABLED=true
WEB_SEARCH_ENABLED=true
CODE_EXEC_ENABLED=true
# MCP: the catalog is served at $PUBLIC_BASE_URL/mcp (https only) and handed to Otari; token protects it
MCP_ENABLED=true
MCP_TOKEN=
# Spend limits on top of Otari's budgets (USD per rolling 24h)
PER_CUSTOMER_DAILY_USD=0.05
APP_DAILY_USD=0.50
INR_PER_USD=84.0
# Set to false to run only the web chat (e.g. a second deployment sharing a bot)
TELEGRAM_ENABLED=true
# Optional: override to use any other OpenAI-compatible endpoint instead of Otari
# LLM_API_KEY=
# LLM_BASE_URL=
# Public URL of this service (Render URL), used for PayPal return/cancel and webhooks
PUBLIC_BASE_URL=http://localhost:8000
STORE_NAME=Noor Boutique
DB_PATH=shoppal.db
CATALOG_PATH=data/catalog.json
